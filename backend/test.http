### 3. Simulamos que Juan Pérez activa su suscripción en la Base de Datos (En pgAdmin ejecuta: UPDATE usuarios SET suscripcion_activa = TRUE WHERE email = 'juan.perez@email.com';)
# Luego de activarla, Juan Pérez vuelve a ver el catálogo
# (El sistema debe aplicarle el 15% de descuento sobre el precio público y calcular tu 5% de mantenimiento)
GET http://localhost:3000/api/products/clinic/d90d4ec5-c5f7-4ac7-8324-d2ad55205304
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjliOGFlZmQ4LTRhYjUtNDVmYS1hNmY3LTM1NjUxNTRjZTMzYiIsImVtYWlsIjoianVhbi5wZXJlekBlbWFpbC5jb20iLCJpYXQiOjE3OTMyNTM5OTUsImV4cCI6MTc5NTg0NTk5NX0._8N2CyS_qN9Ns9s6_k2hFhwYecmL1XC1vYvrrcULjG4

### Registrar a Pedro (Nace SIN suscripción)
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
    "fullName": "Pedro Gomez",
    "email": "pedro.gomez@email.com",
    "password": "MiPasswordSeguro123",
    "phone": "3009876543"
}

### Login de Pedro (Copia el token que te devuelva)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
    "email": "pedro.gomez@email.com",
    "password": "MiPasswordSeguro123",
    "deviceId": "android_pedro_001"
}

### 1. El usuario intenta pagar un producto (Checkout)
# Se usa el Token del usuario (Juan o Pedro) y el ID del producto que quieren comprar
POST http://localhost:3000/api/payments/checkout
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjliOGFlZmQ4LTRhYjUtNDVmYS1hNmY3LTM1NjUxNTRjZTMzYiIsImVtYWlsIjoianVhbi5wZXJlekBlbWFpbC5jb20iLCJpYXQiOjE3OTMyNTM5OTUsImV4cCI6MTc5NTg0NTk5NX0._8N2CyS_qN9Ns9s6_k2hFhwYecmL1XC1vYvrrcULjG4

{
    "producto_id": "73fed521-6a4b-411a-a984-d2606742b08d"
}

### 2. La pasarela (Wompi) avisa a escondidas que el pago fue exitoso (Webhook)
# Nota: Este no lleva token porque lo envía el banco, no el usuario.
POST http://localhost:3000/api/payments/webhook
Content-Type: application/json

{
    "id_transaccion": "WOMPI-987654321",
    "estado": "APROBADO",
    "producto_id": "73fed521-6a4b-411a-a984-d2606742b08d",
    "usuario_id": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjliOGFlZmQ4LTRhYjUtNDVmYS1hNmY3LTM1NjUxNTRjZTMzYiIsImVtYWlsIjoianVhbi5wZXJlekBlbWFpbC5jb20iLCJpYXQiOjE3OTMyNTM5OTUsImV4cCI6MTc5NTg0NTk5NX0._8N2CyS_qN9Ns9s6_k2hFhwYecmL1XC1vYvrrcULjG4"
}